# คัดลอกเป็น .env บนเครื่อง server แล้วใส่ค่าจริง — .env ต้องไม่ถูก commit
#
#   cp .env.example .env && chmod 600 .env
#
# สร้างรหัสผ่านสุ่ม:  openssl rand -base64 32

# --- PostgreSQL (บังคับ) ---
POSTGRES_DB=hrcp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Backup ---
# เวลาที่ dump ทุกวัน รูปแบบ HH:MM 24 ชม. ตามเวลาไทย
BACKUP_AT=02:00
# เก็บไฟล์ backup กี่วัน
BACKUP_KEEP_DAYS=14

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
