# คัดลอกเป็น .env บนเครื่อง server แล้วใส่ค่าจริง — .env ต้องไม่ถูก commit
#
#   cp .env.example .env && chmod 600 .env
#
# สร้างรหัสผ่านสุ่ม:  openssl rand -base64 32

# --- PostgreSQL (บังคับ) ---
POSTGRES_DB=hrcp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Backup ---
# เวลาที่ dump ทุกวัน รูปแบบ HH:MM 24 ชม. ตามเวลาไทย
BACKUP_AT=02:00
# เก็บไฟล์ backup กี่วัน
BACKUP_KEEP_DAYS=14

# --- Email (KKU SMTP Relay / IP-whitelisted) ---
SMTP_HOST=smtp.kku.ac.th
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAILER_FROM=noreply@kku.ac.th
MAILER_FROM_NAME="วิทยาลัยการคอมพิวเตอร์ มหาวิทยาลัยขอนแก่น"
