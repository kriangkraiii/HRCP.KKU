' รูปแบบร่วมของแผนภาพยูสเคสทุกภาพ
' นำเข้าด้วย !include _style.puml
!pragma layout smetana
skinparam defaultFontName "Tahoma"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam ArrowColor #37474F
skinparam ArrowFontSize 11
skinparam ArrowFontColor #455A64

skinparam actor {
  BorderColor #37474F
  BackgroundColor #ECEFF1
  FontSize 13
}
skinparam usecase {
  BorderColor #546E7A
  BackgroundColor #FFFFFF
  FontSize 13
  BorderThickness 1
}
skinparam rectangle {
  BorderColor #263238
  BackgroundColor #FAFAFA
  FontSize 14
  FontStyle bold
}
