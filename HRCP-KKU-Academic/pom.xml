<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.ecom</groupId>
	<artifactId>HRCP_KKU</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>HRCP_KKU</name>
	<description>HRCP KKU - ระบบจัดการบุคลากรทางวิชาการ</description>
	<properties>
		<java.version>21</java.version>
		<skipTests>false</skipTests>
	</properties>
	<dependencies>

		<!-- ============================================================ -->
		<!-- Spring Boot Core Starters                                    -->
		<!-- ============================================================ -->
	    <dependency>
	        <groupId>org.springframework.boot</groupId>
	        <artifactId>spring-boot-starter-actuator</artifactId>
	    </dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Passay 2.0.0 Password Complexity Library (ISO 27001 A.9) -->
		<dependency>
			<groupId>org.passay</groupId>
			<artifactId>passay</artifactId>
			<version>2.0.0</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<!-- Without this devtools is a compile-scope dependency and gets
			     packaged into the fat jar, leaving restart/livereload active
			     in a production `java -jar` run. -->
			<optional>true</optional>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- ============================================================ -->
		<!-- Testing                                                       -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Lets tests authenticate as a given user, so access rules that decide
		     who may read a signature image are verified through the real filter
		     chain rather than only at the service layer. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.jqwik</groupId>
			<artifactId>jqwik</artifactId>
			<version>1.10.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Runs the suite against a real PostgreSQL instead of H2.
		     Production is PostgreSQL and the schema is built by Flyway, but the
		     test profile turned Flyway off and let Hibernate build the schema
		     from the entities instead — so V5 onwards (PostgreSQL partial
		     indexes, which H2 cannot express at all) have never once been
		     executed by the build. See FlywayMigrationRunTest's own note. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers 2.x renamed every module artifact with a
		     `testcontainers-` prefix; the old `junit-jupiter` / `postgresql`
		     coordinates resolve to nothing on the 2.0.5 that Boot 4.1 manages. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-database-commons</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Drives a real browser. The forms this system lives on are mostly
		     JavaScript — the Scopus picker modal, the rows that grow on demand,
		     the auto-draft listener and the signature canvas — and none of that
		     is reachable from MockMvc. Bound to the `e2e` profile so the normal
		     build stays fast and needs no browser download. -->
		<dependency>
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<version>1.49.0</version>
			<scope>test</scope>
		</dependency>

		<!-- ============================================================ -->
		<!-- Database                                                      -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Flyway Schema Migration (ISO 27001 A.14) -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!--
			Boot 4 moved each technology's auto-configuration into its own module.
			Without this one, flyway-core sits on the classpath doing nothing and
			every spring.flyway.* property is silently ignored — which is exactly
			what happened here: no flyway_schema_history table was ever created,
			so V0–V10 never ran and Hibernate's ddl-auto built the whole schema.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>

		<!-- ============================================================ -->
		<!-- AWS S3 Only (lightweight, no full SDK)                        -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>com.amazonaws</groupId>
			<artifactId>aws-java-sdk-s3</artifactId>
			<version>1.12.797</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- JAXB API (XML binding)                                        -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.4.0-b180830.0359</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- ZXing QR Code Generation                                      -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>core</artifactId>
			<version>3.5.4</version>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>javase</artifactId>
			<version>3.5.4</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- Zip4j - AES-256 Encrypted ZIP                                 -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>net.lingala.zip4j</groupId>
			<artifactId>zip4j</artifactId>
			<version>2.11.6</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- Apache POI - DOCX Processing                                  -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.5.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml-full</artifactId>
			<version>5.5.1</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- poi-tl - DOCX Template Engine ({{variable}} replacement)      -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>com.deepoove</groupId>
			<artifactId>poi-tl</artifactId>
			<version>1.12.2</version>
			<exclusions>
				<exclusion>
					<groupId>org.apache.poi</groupId>
					<artifactId>poi-ooxml</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.poi</groupId>
					<artifactId>poi-ooxml-schemas</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.poi</groupId>
					<artifactId>poi</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- ============================================================ -->
		<!-- JODConverter - DOCX→PDF via LibreOffice (100% format fidelity)-->
		<!-- ============================================================ -->
		<dependency>
			<groupId>org.jodconverter</groupId>
			<artifactId>jodconverter-local</artifactId>
			<version>4.4.11</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- XDocReport - DOCX→PDF converter (opensagres + iText/OpenPDF)  -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>fr.opensagres.xdocreport</groupId>
			<artifactId>fr.opensagres.poi.xwpf.converter.pdf</artifactId>
			<version>2.2.0</version>
		</dependency>

		<!-- ============================================================ -->
		<!-- Jackson - JSON Processing                                     -->
		<!-- ============================================================ -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

	</dependencies>
	<build>
    <plugins>
        <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
                <!-- ข้ามเทสต์โดยค่าเริ่มต้นเหมือนเดิม แต่สั่งรันได้ด้วย -DskipTests=false -->
                <skipTests>${skipTests}</skipTests>
                <systemPropertyVariables>
                    <spring.profiles.active>test</spring.profiles.active>
                </systemPropertyVariables>
                <!-- The browser suite needs a Playwright download and a running
                     Docker daemon, so it is not part of `mvn test`. It runs
                     under -Pe2e via failsafe instead. -->
                <excludes>
                    <exclude>**/*E2ETest.java</exclude>
                </excludes>
            </configuration>
        </plugin>
        <!-- OWASP Dependency-Check — scan for known CVEs in third-party libs (ISO 27001 A.12) -->
        <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>13.0.0</version>
            <configuration>
                <failBuildOnCVSS>7</failBuildOnCVSS>
                <formats>HTML,JSON</formats>
                <outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
            </configuration>
        </plugin>
    </plugins>
</build>

<profiles>
    <!-- Browser-level end-to-end suite.
         Split out because it needs three things the normal build does not: a
         running Docker daemon (PostgreSQL via Testcontainers), a Playwright
         browser download, and a couple of minutes. Run with:
             ./mvnw verify -Pe2e -DskipTests=false -->
    <profile>
        <id>e2e</id>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <skipTests>${skipTests}</skipTests>
                        <includes>
                            <include>**/*E2ETest.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </build>
    </profile>
</profiles>
</project>
