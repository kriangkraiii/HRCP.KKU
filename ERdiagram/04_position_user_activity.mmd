flowchart TD
    START(("●")) --> A["Position Dashboard"]

    subgraph Create["Create New Request"]
        A --> B{"Has Active Request?"}
        B -->|"Yes"| STOP["Error: active_exists"]
        B -->|"No"| C{"Has Draft?"}
        C -->|"Yes"| D["Open existing Draft"]
        C -->|"No"| E["Select Evaluation\nfrom Phase 1 passed"]
        E --> F["Create Draft\nLink to AcademicRequest\nstatus = DRAFT"]
        F --> D
    end

    subgraph FillDoc["Fill Documents 1,2,3,4,6,7,9"]
        D --> G["Request Detail\nShow 9 Documents"]
        G --> H["Select Document\nDoc 1,2,3,4,6,7,9"]
        H --> I["Fill Form"]
        I --> J{"Select Action"}
        J -->|"Save Draft"| K["saveDraft\nfilledBy = APPLICANT"]
        K --> H
        J -->|"Submit"| L["saveDocument\nfilledBy = APPLICANT"]
        L --> G
    end

    subgraph Submit["Submit Request"]
        G --> M{"Doc 1,2,3,4,6,7,9\nAll completed?"}
        M -->|"No"| N["Error: incomplete_docs"]
        N --> G
        M -->|"Yes"| O["Submit Request"]
        O --> P["DRAFT to DOCUMENT_RECEIVED\nSet submissionDate"]
    end

    subgraph Track["Track Status"]
        P --> Q["Dashboard\nProgress Tracker"]
        Q --> R["View Status History"]
    end

    STOP --> ENDX(("◉"))
    R --> ENDX

    style START fill:#000,color:#fff
    style ENDX fill:#000,color:#fff
