flowchart TD
    START(("●")) --> A["Petition Page"]

    subgraph User["Applicant - USER"]
        A --> B{"Has Active Petition?"}
        B -->|"Yes"| C["Page: cannot_submit\nActive petition exists"]
        B -->|"No"| D["Fill Petition Form\nTitle + Description"]
        D --> E{"Validation Pass?"}
        E -->|"No"| F["Show Error"]
        F --> D
        E -->|"Yes"| G["Create Petition\nstatus = RECEIVED"]
        G --> H["View Petition Detail"]
        H --> I["View Status History"]
        A --> J["View All Petitions\n/petitions/my-petitions"]
    end

    subgraph Admin["Administrator - ADMIN"]
        K["Change Petition Status"] --> L{"Selected Status?"}
        L -->|COMMITTEE_ASSIGNED| M["แต่งตั้งอนุกรรมการ"]
        L -->|MEETING_SCHEDULED| N["นัดหมายวันประชุม"]
        L -->|RESULT_APPROVED| O["แจ้งผล - ผ่าน"]
        L -->|RESULT_REVISION| P["แจ้งผล - แก้ไข"]
        L -->|REJECTED| Q["ไม่รับคำร้อง"]
        L -->|COMPLETED| R["เสร็จสิ้น"]
        M & N & O & P & Q & R --> S["Save PetitionStatus"]
    end

    C --> ENDX(("◉"))
    I --> ENDX
    J --> ENDX
    S --> ENDX

    style START fill:#000,color:#fff
    style ENDX fill:#000,color:#fff
