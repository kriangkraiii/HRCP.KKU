%%{init: {"flowchart": {"curve": "linear"}}}%%
flowchart LR
  %% DFD Level 1A: Request Domain (P1-P4)
  subgraph L["External Entities"]
    direction TB
    G["Guest\nผู้เยี่ยมชม"]
    A["Applicant\nผู้ยื่นคำร้อง"]
    AD["Admin\nผู้ดูแลระบบ"]
  end

  subgraph C["Request Processes"]
    direction TB
    P1(("P1 Authentication\nยืนยันตัวตน"))
    P2(("P2 Academic Request\nคำร้องวิชาการ"))
    P3(("P3 Position Request\nคำร้องตำแหน่ง"))
    P4(("P4 Petition Management\nจัดการคำร้องทั่วไป"))
  end

  subgraph R["Stores & Targets"]
