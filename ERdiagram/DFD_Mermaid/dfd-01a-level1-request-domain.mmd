    D1[["user_dtls"]]
    D2[["academic_request group"]]
    D3[["position_request group"]]
    D4[["petitions group"]]
    ES["Email Service\nบริการอีเมล"]
    HR["External HR\nหน่วยงานบุคคลภายนอก"]
