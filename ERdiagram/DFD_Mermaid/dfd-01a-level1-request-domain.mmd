  G --> P1
  A --> P1
  A --> P2
  A --> P3
  A --> P4
  AD --> P2
  AD --> P3

  P1 <--> D1
  P2 <--> D2
  P3 <--> D3
  P4 <--> D4

  P2 -->|"Notification / แจ้งผล"| ES
  P3 -->|"Notification / แจ้งผล"| ES
  P4 -->|"Notification / แจ้งผล"| ES
  P3 -->|"Completed Pass / ส่งต่อคำร้องผ่าน"| HR

  classDef ext fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  classDef proc fill:#fff,stroke:#000,stroke-width:2px,color:#000;
  classDef store fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  class G,A,AD,ES,HR ext;
