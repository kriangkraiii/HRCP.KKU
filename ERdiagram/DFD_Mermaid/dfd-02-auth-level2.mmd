%%{init: {"flowchart": {"curve": "linear"}}}%%
flowchart LR
  %% DFD Level 2: Authentication / การยืนยันตัวตน
  subgraph L["Entity"]
    direction TB
    E1["E1 User/Admin / ผู้ใช้และผู้ดูแล"]
  end

  subgraph C["Processes"]
    direction TB
    P11(("P1.1 Login\nเข้าสู่ระบบ"))
    P12(("P1.2 First-Login OTP\nส่ง OTP ครั้งแรก"))
    P13(("P1.3 Verify OTP + Set Password\nยืนยัน OTP และตั้งรหัสผ่าน"))
    P14(("P1.4 Forgot Password\nลืมรหัสผ่าน"))
    P15(("P1.5 Reset Password\nรีเซ็ตรหัสผ่าน"))
    P16(("P1.6 Logout\nออกจากระบบ"))
  end

  subgraph R["Stores & External Service"]
    direction TB
    D1[["D1 user_dtls"]]
    D6[["D6 notifications/admin_logs"]]
    E5["E5 Email Service / บริการอีเมล"]
  end

  E1 -->|"credentials / ข้อมูลเข้าสู่ระบบ"| P11
  P11 <--> D1
  P11 -->|"first login / เข้าระบบครั้งแรก"| P12
  P12 -->|"OTP"| E5
  E1 -->|"OTP + new password"| P13
  P13 <--> D1
  P13 --> D6

  E1 -->|"forgot password request"| P14
  P14 <--> D1
  P14 -->|"reset link / ลิงก์รีเซ็ต"| E5
  E1 -->|"token + new password"| P15
  P15 <--> D1
  P15 --> D6

  E1 -->|"logout"| P16
  P16 --> D6

  classDef ext fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  classDef proc fill:#fff,stroke:#000,stroke-width:1.8px,color:#000;
  classDef store fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  class E1,E5 ext;
  class P11,P12,P13,P14,P15,P16 proc;
  class D1,D6 store;
