%%{init: {"flowchart": {"curve": "linear"}}}%%
flowchart LR
  %% DFD Level 2: Expiry Scheduler
  subgraph L["Entities"]
    direction TB
    E4["E4 Scheduler / ตัวตั้งเวลา"]
    E3["E3 Admin / ผู้ดูแลระบบ"]
  end

  subgraph C["Processes"]
    direction TB
    P101(("P10.1 Scan evaluation_expiry_date\nตรวจสอบ evaluation_expiry_date"))
    P102(("P10.2 Determine Alert Windows\nกำหนดช่วงเตือน 6m / 3m / 1m / 1w"))
    P103(("P10.3 Create Alert Jobs\nสร้างงานแจ้งเตือน"))
    P104(("P10.4 Send Alerts\nส่งการแจ้งเตือน"))
    P105(("P10.5 Log Scheduler\nบันทึกการทำงานตัวตั้งเวลา"))
  end

  subgraph R["Stores & Service"]
    direction TB
    D1[["D1 user_dtls (alert flags)"]]
    D2[["D2 academic_request"]]
    D6[["D6 notifications / admin_logs"]]
    E5["E5 Email Service / บริการอีเมล"]
  end

  E4 --> P101
  P101 --> D2
  P101 --> D1
  P101 --> P102

  P102 -->|"6m / 3m / 1m / 1w"| P103
  P103 --> D6
  P103 --> P104

  P104 --> E5
  E5 -->|"delivery status / สถานะการส่ง"| P104
  P104 --> D6
  P104 -->|"alert summary / สรุปการแจ้งเตือน"| E3

  P101 --> P105
  P102 --> P105
  P103 --> P105
  P104 --> P105
  P105 --> D6

  classDef ext fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  classDef proc fill:#fff,stroke:#000,stroke-width:1.8px,color:#000;
  classDef store fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  class E4,E3,E5 ext;
  class P101,P102,P103,P104,P105 proc;
  class D1,D2,D6 store;
