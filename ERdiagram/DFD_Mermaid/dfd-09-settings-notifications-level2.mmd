%%{init: {"flowchart": {"curve": "linear"}}}%%
flowchart LR
  %% DFD Level 2: Settings & Notifications
  subgraph L["Entities"]
    direction TB
    E2["E2 User / ผู้ใช้งาน"]
    E3["E3 Admin / ผู้ดูแลระบบ"]
  end

  subgraph C["Processes"]
    direction TB
    P91(("P9.1 Update Profile\nอัปเดตโปรไฟล์"))
    P92(("P9.2 Change Password\nเปลี่ยนรหัสผ่าน"))
    P93(("P9.3 Toggle Settings\nตั้งค่า autoDraft / alerts / 2FA"))
    P94(("P9.4 Prepare Notification\nจัดเตรียมการแจ้งเตือน"))
    P95(("P9.5 Send Notification Email\nส่งอีเมลแจ้งเตือน"))
  end

  subgraph R["Stores & Service"]
    direction TB
    D1[["D1 user_dtls (settings flags)"]]
    D6[["D6 notifications / admin_logs"]]
    E5["E5 Email Service / บริการอีเมล"]
  end

  E2 --> P91
  E2 --> P92
  E2 --> P93
  E3 --> P94

  P91 --> D1
  P92 --> D1
  P93 --> D1

  P94 --> D6
  P94 --> P95
  P95 --> E5
  E5 -->|"delivery status / สถานะการส่ง"| P95
  P95 --> D6

  P91 --> D6
  P92 --> D6
  P93 --> D6

  classDef ext fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  classDef proc fill:#fff,stroke:#000,stroke-width:1.8px,color:#000;
  classDef store fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  class E2,E3,E5 ext;
  class P91,P92,P93,P94,P95 proc;
  class D1,D6 store;
