%%{init: {"flowchart": {"curve": "linear"}}}%%
flowchart LR
  %% DFD Level 2: Position Request / คำร้องตำแหน่งทางวิชาการ
  subgraph L["Entities"]
    direction TB
    E2["E2 Applicant / ผู้ยื่นคำร้อง"]
    E3["E3 Admin / ผู้ดูแลระบบ"]
  end

  subgraph C["Processes"]
    direction TB
    P31(("P3.1 Eligibility Check\nตรวจสิทธิ์"))
    P32(("P3.2 Create Draft\nสร้างฉบับร่าง"))
    P33(("P3.3 Fill User Docs\nกรอกเอกสารผู้ยื่น"))
    P34(("P3.4 Submit Request\nส่งคำร้อง"))
    P35(("P3.5 Admin Review + Status Chain\nทบทวนและปรับสถานะ"))
    P36(("P3.6 Fill Admin Docs 5/8\nกรอกเอกสารผู้ดูแล 5/8"))
    P37(("P3.7 Send to HR\nส่งต่อให้ HR"))
  end

  subgraph R["Stores & External Target"]
    direction TB
    D2[["D2 academic_request"]]
    D3[["D3 position_request"]]
    D31[["D3.1 position_document"]]
    D32[["D3.2 position_attachment"]]
    D33[["D3.3 position_status_history"]]
    E6["E6 HR Office / งานทรัพยากรบุคคล"]
  end

  E2 --> P31
  P31 -->|"check COMPLETED_PASS + not expired"| D2
  P31 -->|"eligible / ผ่านเงื่อนไข"| P32
  P31 -->|"ineligible / ไม่ผ่านเงื่อนไข"| E2

  P32 --> D3
  E2 --> P33 --> D31
  E2 -->|"attachments / ไฟล์แนบ"| D32
  E2 --> P34
  P34 -->|"submit + status=DOCUMENT_RECEIVED"| D3
  P34 --> D33

  E3 --> P35
  P35 --> D3
  P35 --> D33
  E3 --> P36 --> D31

  P35 -->|"status=COLLEGE_APPROVED"| P37
  P37 -->|"status=SENT_TO_HR"| D3
  P37 --> D33
  P37 --> E6

  classDef ext fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  classDef proc fill:#fff,stroke:#000,stroke-width:1.8px,color:#000;
  classDef store fill:#fff,stroke:#000,stroke-width:1px,color:#000;
  class E2,E3,E6 ext;
  class P31,P32,P33,P34,P35,P36,P37 proc;
  class D2,D3,D31,D32,D33 store;
